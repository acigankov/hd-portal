# Скопируйте файл в .env и заполните значения. .env в репозиторий не коммитится.

# --- Окружение ---
# prod | dev | test. По умолчанию (если переменной нет) — prod.
YII_ENV=dev
# Отладка. В production ОБЯЗАТЕЛЬНО false.
YII_DEBUG=true
# IP, которым разрешены Debug-панель и Gii (только при YII_ENV=dev).
# Список через запятую. Gii создаёт файлы на сервере — никогда не указывайте здесь *.
DEV_TOOLS_ALLOWED_IPS=127.0.0.1,::1

# --- Безопасность ---
# Обязательный ключ подписи cookie. Сгенерировать:
#   php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
# У каждого окружения должен быть свой ключ.
COOKIE_VALIDATION_KEY=

# Ключ шифрования паролей почтовых ящиков (IMAP/SMTP) в базе. Сгенерировать:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Если ключ не задан, используется COOKIE_VALIDATION_KEY.
# ВАЖНО: при смене ключа сохранённые пароли ящиков придётся ввести заново.
APP_SECRET_KEY=

# Единый пароль для сид-миграции пользователей (только локальная разработка).
# Если не задан, миграция сгенерирует случайные пароли и напечатает их один раз.
SEED_DEFAULT_PASSWORD=

# --- База данных ---
MYSQL_DSN=mysql:host=mysql;dbname=hd_portal
MYSQL_DATABASE=hd_portal
MYSQL_USER=hd_portal
MYSQL_USER_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_CHARSET=utf8mb4
