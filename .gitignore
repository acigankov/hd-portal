```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
vendor/
composer.lock
*.lock
.env
.env.local
.env.*

# Build directories
dist/
build/
target/
coverage/
htmlcov/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Cache directories
.mypy_cache/
.pytest_cache/
.gradle/
.cargo/
```